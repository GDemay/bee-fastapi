# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Docker Compose (host port mapping)
API_PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/user_registration
DATABASE_POOL_MIN_SIZE=5
DATABASE_POOL_MAX_SIZE=20

# Email Configuration
# Options: "mailhog" (local development) or "resend" (production)
EMAIL_PROVIDER=mailhog

# Mailhog (local development)
MAILHOG_API_URL=http://mailhog:8025

# Resend (production - get API key from https://resend.com)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Security
ACTIVATION_CODE_EXPIRY_SECONDS=60
